@using MailArchiver.Services.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@model MailArchiver.Models.ViewModels.IntegrityStorageViewModel
@{
    ViewData["Title"] = Localizer["Integrity & Storage"];
    var settingsOk = TempData["SettingsOk"] as bool?;
    var settingsMessage = TempData["SettingsMessage"] as string;
    string Utc(DateTime? time) => time.HasValue ? time.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "-";
    string Size(long bytes) => bytes >= 1048576 ? (bytes / 1048576.0).ToString("0.0") + " MB" : bytes >= 1024 ? (bytes / 1024.0).ToString("0.0") + " KB" : bytes + " B";
    var editable = Model.Settings.Where(s => s.Group == SettingGroup.Editable).ToList();
    var locked = Model.Settings.Where(s => s.Group == SettingGroup.Locked).ToList();
}

<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
        <h1 class="h3 mb-0"><i class="bi bi-shield-check me-2"></i>@Localizer["Integrity & Storage"]</h1>
        <div class="btn-group btn-group-sm" role="group" aria-label="Sections">
            <a class="btn btn-outline-secondary" href="#overview">Overview</a>
            <a class="btn btn-outline-secondary" href="#manifests">Manifests</a>
            <a class="btn btn-outline-secondary" href="#bin">Original bin</a>
            <a class="btn btn-outline-secondary" href="#text">Attachment text</a>
            <a class="btn btn-outline-secondary" href="#settings">Settings</a>
        </div>
    </div>

    <p class="text-muted">
        Checks that the archive still matches what was stored, the signed records of it, the recycle bin for deleted emails' originals,
        and the settings of these features. Admins only. Everything done here is written to the access log, and the changes to settings
        and the actions that matter are also written to the audit chain.
    </p>

    <form id="af" method="post" asp-action="RunVerifyAll"></form>

    @* ================================================================ OVERVIEW *@
    <div class="card mb-3" id="overview">
        <div class="card-header"><strong>Overview</strong></div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("overview", out var overviewError))
            {
                <div class="alert alert-danger">This section could not be loaded: @overviewError</div>
            }
            <h2 class="h6">Verify-all</h2>
            <p class="small text-muted mb-2">Re-checks every email against its stored original (hash, headers, bodies, attachments, audit chain).</p>
            <div id="runBox" class="mb-2">
                @if (Model.LastRun == null)
                {
                    <span class="text-muted">No run yet.</span>
                }
                else
                {
                    <span id="runText">
                        Last run #@Model.LastRun.Id: <strong>@Model.LastRun.Status</strong>, started @Utc(Model.LastRun.StartedAt)@(Model.LastRun.FinishedAt.HasValue ? ", finished " + Utc(Model.LastRun.FinishedAt) : "").
                        Checked @Model.LastRun.Checked of @Model.LastRun.Total: valid @Model.LastRun.Valid, invalid @Model.LastRun.Invalid, missing @Model.LastRun.Missing,
                        not stored @Model.LastRun.NotStored, inconsistent @Model.LastRun.Inconsistent, errors @Model.LastRun.Errors.
                    </span>
                }
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="btnVerifyAll"><i class="bi bi-play-fill"></i> Run verify-all now</button>
            <span id="runMsg" class="ms-2 small"></span>

            <hr />
            <h2 class="h6">Audit chain</h2>
            <p class="small text-muted mb-2">Walks the whole hash chain and reports the first break, originals that changed since they were archived, and deleted or binned originals.</p>
            <button type="button" class="btn btn-primary btn-sm" id="btnChain"><i class="bi bi-link-45deg"></i> Check audit chain</button>
            <div id="chainResult" class="mt-2 small"></div>

            <hr />
            <h2 class="h6">Chain head (anchor)</h2>
            <p class="small text-muted mb-2">One line that describes the chain as of now. Keep a copy somewhere the archive server cannot change (a note, a private repository, another machine).</p>
            <div class="input-group input-group-sm">
                <input type="text" class="form-control font-monospace" id="anchorLine" readonly value="@Model.AnchorLine" />
                <button class="btn btn-outline-secondary" type="button" id="btnCopyAnchor">Copy</button>
            </div>
        </div>
    </div>

    @* ================================================================ MANIFESTS *@
    <div class="card mb-3" id="manifests">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Signed manifests</strong>
            <button type="button" class="btn btn-primary btn-sm" id="btnManifest"><i class="bi bi-pen"></i> Create signed manifest</button>
        </div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("manifests", out var manifestError))
            {
                <div class="alert alert-danger">This section could not be loaded: @manifestError</div>
            }
            <p class="small text-muted">
                A manifest lists every stored original with its hash and the chain head, signed so that anyone can check it without this software.
                @if (!string.IsNullOrEmpty(Model.PublicKeyFingerprint))
                {
                    <span>Public key fingerprint (SHA-256): <code>@Model.PublicKeyFingerprint</code>. <a asp-action="DownloadManifestFile" asp-route-kind="key">Download public-key.pem</a></span>
                }
                else
                {
                    <span>No signing key yet: it is created with the first manifest.</span>
                }
            </p>
            <div id="manifestMsg" class="small mb-2"></div>
            @if (Model.Manifests.Count == 0)
            {
                <p class="text-muted">No manifests yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Name</th><th>Created</th><th class="text-end">Originals</th><th class="text-end">Chain seq</th><th>Files</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.Manifests)
                        {
                            <tr>
                                <td><code>@m.Name</code></td>
                                <td>@Utc(m.GeneratedAt)</td>
                                <td class="text-end">@m.Entries</td>
                                <td class="text-end">@(m.ChainSeq?.ToString() ?? "-")</td>
                                <td class="text-nowrap">
                                    <a asp-action="DownloadManifestFile" asp-route-name="@m.Name" asp-route-kind="json">json</a> ·
                                    <a asp-action="DownloadManifestFile" asp-route-name="@m.Name" asp-route-kind="sig">sig</a> ·
                                    <a asp-action="DownloadManifestFile" asp-route-name="@m.Name" asp-route-kind="jsonl">entries</a>
                                </td>
                                <td class="text-end"><button type="button" class="btn btn-outline-secondary btn-sm btn-verify-manifest" data-name="@m.Name">Verify</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                var first = Model.Manifests[0].Name;
                <p class="small text-muted mb-1">Check the newest manifest yourself, on any machine with the three files and the public key:</p>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control font-monospace" id="opensslCmd" readonly
                           value="openssl dgst -sha256 -verify public-key.pem -signature @(first).sig @(first).json" />
                    <button class="btn btn-outline-secondary" type="button" id="btnCopyOpenssl">Copy</button>
                </div>
            }
        </div>
    </div>

    @* ================================================================ ORIGINAL BIN *@
    <div class="card mb-3" id="bin">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Original bin</strong>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBinRun">Run now</button>
        </div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("bin", out var binError))
            {
                <div class="alert alert-danger">This section could not be loaded: @binError</div>
            }
            <p class="small text-muted">
                When an email is deleted and no other email shares its original, the original file goes into this bin. It can be restored until the
                retention period is over; after that it is deleted for good (only a backup can bring it back).
            </p>
            @if (Model.BinStatus != null)
            {
                var b = Model.BinStatus;
                <p class="mb-2">
                    <span class="badge @(b.Enabled && b.Applicable ? "bg-success" : "bg-secondary")">@(b.Enabled ? (b.Applicable ? "on" : "on, not applicable") : "off")</span>
                    Retention @b.BinRetentionDays days · runs every @b.IntervalHours h · at most @b.MaxFilesPerRun files per run.
                    In the bin now: <strong>@b.InBin</strong> (@Size(b.InBinBytes))@(b.EarliestPurgeAt.HasValue ? ", the first is deleted for good after " + Utc(b.EarliestPurgeAt) : "").
                    Total moved @b.TotalBinned, restored @b.TotalRestored, deleted for good @b.TotalPurged.
                </p>
                @if (!b.Applicable)
                {
                    <p class="small text-warning">Not applicable to this archive: @b.NotApplicableReason</p>
                }
                @if (b.LastRun != null)
                {
                    <p class="small text-muted">Last run #@b.LastRun.Id: @b.LastRun.Status, started @Utc(b.LastRun.StartedAt).</p>
                }
            }
            <div id="binMsg" class="small mb-2"></div>
            @if (Model.BinItems.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Original (SHA-256)</th><th>Binned</th><th>Deleted for good after</th><th class="text-end">Size</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.BinItems)
                        {
                            <tr>
                                <td><code title="@i.Sha256">@(i.Sha256[..16])…</code></td>
                                <td>@Utc(i.BinnedAt)</td>
                                <td>@Utc(i.PurgeAfter)</td>
                                <td class="text-end">@Size(i.Size)</td>
                                <td class="text-end"><button type="button" class="btn btn-outline-secondary btn-sm btn-bin-restore" data-sha="@i.Sha256">Restore</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.BinStatus != null && Model.BinStatus.InBin > Model.BinItems.Count)
                {
                    <p class="small text-muted">Showing the first @Model.BinItems.Count of @Model.BinStatus.InBin.</p>
                }
            }
            else
            {
                <p class="text-muted">The bin is empty.</p>
            }
        </div>
    </div>

    @* ================================================================ ATTACHMENT TEXT / OCR *@
    <div class="card mb-3" id="text">
        <div class="card-header"><strong>Attachment text and OCR</strong></div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("text", out var textError))
            {
                <div class="alert alert-danger">This section could not be loaded: @textError</div>
            }
            @if (Model.TextStatus != null)
            {
                var t = Model.TextStatus;
                <p class="mb-2">
                    Mode: <span class="badge @(string.Equals(t.Mode, "off", StringComparison.OrdinalIgnoreCase) ? "bg-secondary" : "bg-success")">@t.Mode</span>
                    · waiting to be read: <strong>@t.PendingAttachments</strong> · emails waiting for their search text: <strong>@t.EmailsAwaitingIndex</strong>
                </p>
                <p class="small mb-2">
                    OCR engine:
                    @if (t.OcrEngine != null && t.OcrUnavailable == null) { <span>@t.OcrEngine <span class="badge bg-success">models present</span></span> }
                    else if (t.OcrUnavailable != null) { <span class="badge bg-warning text-dark">not available</span> <span class="text-muted">@t.OcrUnavailable</span> }
                    else { <span class="text-muted">not loaded (the mode is off, or nothing needed OCR yet)</span> }
                </p>
                @if (t.Texts.Count > 0)
                {
                    <table class="table table-sm w-auto">
                        <thead><tr><th>Result</th><th>Method</th><th class="text-end">Attachments</th></tr></thead>
                        <tbody>
                        @foreach (var x in t.Texts)
                        {
                            <tr><td>@x.Status</td><td>@x.Method</td><td class="text-end">@x.Count</td></tr>
                        }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted">Nothing read yet.</p> }
            }
            <div id="textMsg" class="small mb-2"></div>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-rescan" data-scope="failed">Rescan failed</button>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-rescan" data-scope="needsocr">Rescan needs-OCR</button>
            <span class="small text-muted ms-2">A rescan only forgets those results; the worker reads them again in the background.</span>
        </div>
    </div>

    @* ================================================================ SETTINGS *@
    <div class="card mb-3" id="settings">
        <div class="card-header"><strong>Settings</strong></div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("settings", out var settingsError))
            {
                <div class="alert alert-danger">This section could not be loaded: @settingsError</div>
            }
            @if (settingsMessage != null)
            {
                <div class="alert @(settingsOk == true ? "alert-success" : "alert-danger")" role="alert">@settingsMessage</div>
            }
            <p class="small text-muted">
                <strong>Locked</strong> settings define the storage guarantee and can only be changed with the environment variable on the host.
                <strong>Editable</strong> settings are stored in the database and apply right away unless it says otherwise. A setting that is also
                set by an environment variable is <em>pinned</em>: the variable wins and the field is locked. Changes that lower a protection need your
                password. Every change is recorded with the old and the new value.
            </p>

            <h2 class="h6">Editable</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Setting</th><th>Value</th><th>Source</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var s in editable)
                    {
                        <tr>
                            <td style="min-width:16rem">
                                <div><strong>@s.Label</strong></div>
                                <div class="small text-muted">@s.Help</div>
                                <div class="small text-muted"><code>@s.EnvVar</code></div>
                                @if (s.RiskyNote != null) { <div class="small text-warning">Lowering a protection: @s.RiskyNote</div> }
                                @if (!s.AppliesLive && s.RestartNote != null) { <div class="small text-info">@s.RestartNote</div> }
                            </td>
                            <td colspan="1" style="min-width:20rem">
                                @if (s.Pinned)
                                {
                                    <div><code>@s.Value</code></div>
                                    <div class="small text-muted"><i class="bi bi-lock-fill"></i> Set by the environment variable <code>@s.EnvVar</code>; it wins over this page.</div>
                                }
                                else
                                {
                                    <form method="post" asp-action="ChangeSetting" class="row g-1 align-items-center">
                                        <input type="hidden" name="key" value="@s.Key" />
                                        <div class="col-auto">
                                            @if (s.Kind == SettingKind.Bool)
                                            {
                                                <select name="value" class="form-select form-select-sm">
                                                    <option value="true" selected="@(s.Value == "true")">on (true)</option>
                                                    <option value="false" selected="@(s.Value == "false")">off (false)</option>
                                                </select>
                                            }
                                            else if (s.Kind == SettingKind.Choice)
                                            {
                                                <select name="value" class="form-select form-select-sm">
                                                    @foreach (var c in s.Choices) { <option value="@c" selected="@(c == s.Value)">@c</option> }
                                                </select>
                                            }
                                            else
                                            {
                                                <input type="number" name="value" value="@s.Value" min="@s.Min" max="@s.Max" class="form-control form-control-sm" style="width:9rem" />
                                            }
                                        </div>
                                        <div class="col-auto">
                                            <input type="password" name="password" autocomplete="current-password" placeholder="password (if asked)" class="form-control form-control-sm" style="width:11rem" />
                                        </div>
                                        <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Save</button></div>
                                    </form>
                                    @if (s.Kind == SettingKind.Int)
                                    {
                                        <div class="small text-muted">Allowed: @s.Min to @s.Max. Default: @s.Default.</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">Default: @s.Default.</div>
                                    }
                                }
                            </td>
                            <td class="small">
                                <span class="badge @(s.Source == "changed in this page" ? "bg-primary" : s.Source == "environment variable" ? "bg-secondary" : "bg-light text-dark border")">@s.Source</span>
                                @if (s.ChangedBy != null) { <div class="text-muted">@s.ChangedBy, @Utc(s.ChangedAt)</div> }
                            </td>
                            <td class="text-end">
                                @if (s.CanEdit && s.Source == "changed in this page")
                                {
                                    <form method="post" asp-action="ResetSetting" onsubmit="return confirm('Reset this setting to its default?');" class="d-flex gap-1 justify-content-end">
                                        <input type="hidden" name="key" value="@s.Key" />
                                        <input type="password" name="password" autocomplete="current-password" placeholder="password (if asked)" class="form-control form-control-sm" style="width:10rem" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">Reset to default</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <h2 class="h6 mt-4">Locked (read-only)</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Setting</th><th>Current value</th><th>Set with</th></tr></thead>
                    <tbody>
                    @foreach (var s in locked)
                    {
                        <tr>
                            <td><div>@s.Label</div><div class="small text-muted">@s.Help</div></td>
                            <td><code>@s.Value</code></td>
                            <td><code>@s.EnvVar</code>@(s.Pinned ? " (set)" : "")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var token = document.querySelector('#af input[name=__RequestVerificationToken]').value;
    var base = '@Url.Action("Index")'.replace(/\/Index$/, '').replace(/\/$/, '');
    function url(action) { return base + '/' + action; }
    function post(action, body) {
        var form = new URLSearchParams(body || {});
        return fetch(url(action), { method: 'POST', credentials: 'same-origin',
            headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' }, body: form })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });
    }
    function show(el, text, ok) { el.textContent = text; el.className = (el.className.replace(/\btext-(success|danger)\b/g, '') + ' ' + (ok ? 'text-success' : 'text-danger')).trim(); }
    function fail(el) { return function (e) { show(el, 'Failed: ' + (e.message || e), false); }; }
    function copy(id) { var i = document.getElementById(id); i.select(); try { navigator.clipboard.writeText(i.value); } catch (e) { document.execCommand('copy'); } }

    // verify-all with progress
    var runMsg = document.getElementById('runMsg'), runText = document.getElementById('runText');
    function describe(r) {
        return 'Run #' + r.id + ': ' + r.status + '. Checked ' + r.checked + ' of ' + r.total + ': valid ' + r.valid + ', invalid ' + r.invalid +
            ', missing ' + r.missing + ', not stored ' + r.notStored + ', inconsistent ' + r.inconsistent + ', errors ' + r.errors + '.';
    }
    function poll() {
        fetch(url('RunStatus'), { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (r) {
            if (!r) return;
            if (!runText) { runText = document.createElement('span'); document.getElementById('runBox').textContent = ''; document.getElementById('runBox').appendChild(runText); }
            runText.textContent = describe(r);
            if (r.status === 'Running') setTimeout(poll, 2000); else show(runMsg, 'Finished: ' + r.status, r.status === 'Completed' && !r.invalid && !r.missing && !r.inconsistent);
        }).catch(fail(runMsg));
    }
    document.getElementById('btnVerifyAll').addEventListener('click', function () {
        show(runMsg, 'Starting...', true);
        post('RunVerifyAll').then(function (r) { if (!r.ok) return show(runMsg, r.message, false); show(runMsg, 'Running...', true); poll(); }).catch(fail(runMsg));
    });

    // chain check
    document.getElementById('btnChain').addEventListener('click', function () {
        var box = document.getElementById('chainResult'); show(box, 'Checking...', true);
        post('CheckChain').then(function (r) {
            if (!r.ok) return show(box, r.message, false);
            var lines = [(r.chainOk ? 'Chain is intact. ' : 'PROBLEM FOUND. ') + r.entries + ' entries' + (r.head ? ', head ' + r.head.seq : '') + '.'];
            if (r.firstBreak) lines.push('First break at entry ' + r.firstBreak.seq + ': ' + r.firstBreak.reason);
            (r.warnings || []).forEach(function (w) { lines.push('Warning: ' + w); });
            lines.push('Emails stored before the chain existed: ' + r.unchained + '. Deleted with a record: ' + r.emailsDeletedWithRecord +
                '. Originals binned ' + r.originalsBinned + ', restored ' + r.originalsRestored + ', deleted for good ' + r.originalsPurged + '.');
            show(box, lines.join('\n'), r.chainOk); box.style.whiteSpace = 'pre-wrap';
        }).catch(fail(box));
    });
    document.getElementById('btnCopyAnchor').addEventListener('click', function () {
        fetch(url('Anchor'), { credentials: 'same-origin' }).then(function (r) { return r.text(); }).then(function (t) {
            var i = document.getElementById('anchorLine'); i.value = t.trim(); copy('anchorLine');
        });
    });

    // manifests
    var mm = document.getElementById('manifestMsg');
    document.getElementById('btnManifest').addEventListener('click', function () {
        show(mm, 'Creating...', true);
        post('CreateManifest').then(function (r) {
            if (!r.ok) return show(mm, r.message, false);
            show(mm, 'Created ' + r.name + ' (' + r.entries + ' originals). Reloading...', true); setTimeout(function () { location.hash = '#manifests'; location.reload(); }, 800);
        }).catch(fail(mm));
    });
    document.querySelectorAll('.btn-verify-manifest').forEach(function (b) {
        b.addEventListener('click', function () {
            show(mm, 'Checking ' + b.dataset.name + '...', true);
            post('VerifyManifest', { name: b.dataset.name }).then(function (r) {
                if (!r.ok) return show(mm, r.message, false);
                var t = r.name + ': ' + (r.manifestOk ? 'OK. ' : 'PROBLEM. ') + 'Signature ' + (r.signatureValid ? 'valid' : 'NOT valid') + ', entry list ' +
                    (r.entriesFileMatches ? 'matches' : 'DOES NOT match') + ', chain head ' + (r.chainStillContainsHead ? 'still in the chain' : 'MISSING or changed') +
                    '. Emails gone or changed since: ' + r.emailsChangedOrMissingSince + '.' + (r.problems && r.problems.length ? ' ' + r.problems.join(' ') : '');
                show(mm, t, r.manifestOk);
            }).catch(fail(mm));
        });
    });
    var oc = document.getElementById('btnCopyOpenssl'); if (oc) oc.addEventListener('click', function () { copy('opensslCmd'); });

    // bin
    var bm = document.getElementById('binMsg');
    document.getElementById('btnBinRun').addEventListener('click', function () {
        if (!confirm('Run the bin now? Originals nobody refers to are moved into the bin, and bin files past their retention are deleted for good.')) return;
        show(bm, 'Starting...', true);
        post('BinRun').then(function (r) { show(bm, r.ok ? 'Run started (status ' + r.status + '). Reload in a moment to see the result.' : r.message, r.ok); }).catch(fail(bm));
    });
    document.querySelectorAll('.btn-bin-restore').forEach(function (b) {
        b.addEventListener('click', function () {
            post('BinRestore', { sha256: b.dataset.sha }).then(function (r) {
                show(bm, r.message, r.ok); if (r.ok) setTimeout(function () { location.hash = '#bin'; location.reload(); }, 800);
            }).catch(fail(bm));
        });
    });

    // attachment text
    var tm = document.getElementById('textMsg');
    document.querySelectorAll('.btn-rescan').forEach(function (b) {
        b.addEventListener('click', function () {
            if (!confirm('Forget the "' + b.dataset.scope + '" results so they are read again?')) return;
            post('OcrRescan', { scope: b.dataset.scope }).then(function (r) {
                show(tm, r.ok ? 'Forgot ' + r.removed + ' result(s); the worker reads them again.' : r.message, r.ok);
            }).catch(fail(tm));
        });
    });
})();
