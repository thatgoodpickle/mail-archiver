@using MailArchiver.Services.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@model MailArchiver.Models.ViewModels.IntegrityStorageViewModel
@{
    ViewData["Title"] = Localizer["Integrity & Storage"];
    var settingsOk = TempData["SettingsOk"] as bool?;
    var settingsMessage = TempData["SettingsMessage"] as string;
    var appliedLines = (TempData["SettingsApplied"] as string)?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    var notAppliedLines = (TempData["SettingsNotApplied"] as string)?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();

    string Utc(DateTime? time) => time.HasValue ? time.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "-";
    string Size(long bytes) => bytes >= 1048576 ? (bytes / 1048576.0).ToString("0.0") + " MB" : bytes >= 1024 ? (bytes / 1024.0).ToString("0.0") + " KB" : bytes + " B";
    string Plural(long n, string one, string many) => n == 1 ? one : many;
    string Id(string key) => key.Replace(':', '-').ToLowerInvariant();

    // A value shown in plain words (on/off, the reading mode); anything else as it is.
    string Plain(string key, string value)
    {
        if (key == "Ocr:Mode") return value switch { "off" => "Off", "cpu" => "On (processor)", "gpu" => "On (graphics card; works like the processor for now)", _ => value };
        return value switch { "true" => "On", "false" => "Off", _ => value };
    }

    // When saving asks for the password, in a sentence.
    string PasswordHint(string? rule) => rule switch
    {
        "off" => "Saving asks for your password when you turn it off.",
        "lower" => "Saving asks for your password when you make it shorter.",
        "zero" => "Saving asks for your password when you turn it off (0).",
        "change" => "Saving asks for your password when you change it.",
        _ => ""
    };

    // The option names still say "Bin" (the old name of the Trash); say so wherever one is shown.
    string Compat(string env) => env.Contains("OriginalCleanup") ? " (the name still says \u201cBin\u201d for compatibility; it means the Trash)" : "";

    // The newest check, in a sentence.
    string RunSentence(MailArchiver.Models.IntegrityRun r)
    {
        var problems = r.Invalid + r.Missing + r.NotStored + r.Inconsistent + r.Errors;
        if (r.Status == MailArchiver.Models.IntegrityRun.Running)
            return $"A check is running: {r.Checked} of {r.Total} emails checked so far.";
        if (r.Status == MailArchiver.Models.IntegrityRun.Completed && problems == 0)
            return $"All {r.Checked} {Plural(r.Checked, "email matches", "emails match")} its original. Checked {Utc(r.FinishedAt ?? r.StartedAt)}.";
        if (r.Status == MailArchiver.Models.IntegrityRun.Completed)
            return $"Checked {r.Checked} emails: {problems} {Plural(problems, "needs", "need")} attention ({r.Invalid} changed, {r.Missing} with the original missing, {r.NotStored} with no original kept, {r.Inconsistent} that differ from the original, {r.Errors} that could not be checked). Checked {Utc(r.FinishedAt ?? r.StartedAt)}.";
        return $"The last check did not finish ({r.Status}). It had checked {r.Checked} of {r.Total} emails.";
    }

    // The reason a result failed, in plain words.
    string Reason(string reason) => reason switch
    {
        "image too small to read" => "the picture is too small to read",
        "timeout" => "it took too long",
        "too large" => "the file is too large",
        "attachment gone" => "the attachment is no longer there",
        "no content" => "the file is empty",
        "" => "no reason was recorded",
        _ => "an unexpected error (" + reason + ")"
    };

    var editable = Model.Settings.Where(s => s.Group == SettingGroup.Editable && !s.Pinned).ToList();
    var pinned = Model.Settings.Where(s => s.Group == SettingGroup.Editable && s.Pinned).ToList();
    var locked = Model.Settings.Where(s => s.Group == SettingGroup.Locked).ToList();
}

<style>
    /* This page only. Neutral colours taken from the active theme; no colour carries meaning on its own. */
    .ims code { color: inherit; background: rgba(127, 127, 127, .16); padding: .05rem .35rem; border-radius: .25rem; font-size: .85em; }
    .ims .ims-badge { display: inline-block; padding: .05rem .55rem; border: 1px solid rgba(127, 127, 127, .45); border-radius: 1rem; font-size: .75rem; font-weight: 400; color: inherit; background: transparent; }
    .ims .ims-intro { max-width: 60rem; }
    .ims .ims-block + .ims-block { border-top: 1px solid var(--border-color, #dee2e6); margin-top: 1.25rem; padding-top: 1.25rem; }
    /* 'Set by the server' sits in its own card, apart from the form above and the locked list below. */
    .ims .ims-block.ims-panel { border: 1px solid var(--border-color, #dee2e6); border-radius: .5rem; padding: 1rem 1.25rem; margin: 1.75rem 0; background: rgba(127, 127, 127, .06); }
    .ims .ims-row { padding: .9rem 0; border-top: 1px solid var(--border-color, #dee2e6); }
    .ims .ims-group > .ims-row:first-of-type { border-top: 0; }
    .ims .ims-result { border-left: 3px solid rgba(127, 127, 127, .6); padding: .4rem .75rem; margin-top: .5rem; white-space: pre-wrap; }
    .ims .ims-result.ok { border-left-color: var(--success-color, #198754); }
    .ims .ims-result.bad { border-left-color: var(--danger-color, #dc3545); }
    .ims .ims-note { display: flex; gap: .4rem; align-items: baseline; }
    .ims details > summary { cursor: pointer; }
    .ims .ims-pw.d-none { display: none !important; }
    .ims h2.ims-h { font-size: 1.05rem; margin-bottom: .15rem; }
    .ims .ims-row.ims-edited { border-left: 3px solid var(--primary-color, #0d6efd); padding-left: .75rem; }
    .ims .ims-error { border-left: 3px solid var(--danger-color, #dc3545); padding: .25rem .6rem; margin-top: .4rem; }
    /* The unsaved-changes status sits in the heading row; its space is always reserved, so nothing shifts when it appears. */
    .ims .ims-headrow { position: sticky; top: 0; z-index: 1030; display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; justify-content: space-between;
        min-height: 2.75rem; padding: .25rem 0; background: var(--card-bg, transparent); }
    .ims .ims-dirty { display: flex; gap: .5rem; align-items: center; }
    .ims .ims-dirty.ims-quiet { visibility: hidden; }
    .ims .ims-table th { font-weight: 600; font-size: .85rem; color: inherit; opacity: .8; }
</style>

<div class="container-fluid ims">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
        <h1 class="h3 mb-0"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>@Localizer["Integrity & Storage"]</h1>
        <nav class="btn-group btn-group-sm" aria-label="Sections">
            <a class="btn btn-outline-secondary" href="#overview">Checks</a>
            <a class="btn btn-outline-secondary" href="#manifests">Signed records</a>
            <a class="btn btn-outline-secondary" href="#bin">Trash</a>
            <a class="btn btn-outline-secondary" href="#text">Attachment text</a>
            <a class="btn btn-outline-secondary" href="#settings">Settings</a>
        </nav>
    </div>

    <p class="text-muted ims-intro">
        Check that the archive is intact, keep signed records of it, manage the Trash for deleted emails' originals, and change the related settings.
        Admins only. Everything you do here is written to the access log.
    </p>

    <form id="af" method="post" asp-action="RunVerifyAll"></form>

    @* ================================================================ CHECKS *@
    <div class="card mb-3" id="overview">
        <div class="card-header"><strong>Checks</strong></div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("overview", out var overviewError))
            {
                <div class="alert alert-danger" role="alert">This part could not be loaded: @overviewError</div>
            }

            <div class="ims-block">
                <h2 class="ims-h">Check all emails</h2>
                <p class="text-muted small mb-2">Check that every stored email still matches its original.</p>
                <div id="runBox" class="mb-2">
                    @if (Model.LastRun == null)
                    {
                        <span class="text-muted">No check has been run yet.</span>
                    }
                    else
                    {
                        <span id="runText">@RunSentence(Model.LastRun)</span>
                    }
                </div>
                <button type="button" class="btn btn-primary btn-sm" id="btnVerifyAll"><i class="bi bi-play-fill" aria-hidden="true"></i> Check all emails now</button>
                <span id="runMsg" class="ms-2 small" role="status"></span>
            </div>

            <div class="ims-block">
                <h2 class="ims-h">Check the history log</h2>
                <p class="text-muted small mb-2">Check that the record of what happened in the archive (the audit chain) has not been changed, and that nothing in it has gone missing.</p>
                <button type="button" class="btn btn-primary btn-sm" id="btnChain"><i class="bi bi-link-45deg" aria-hidden="true"></i> Check the history log</button>
                <div id="chainResult" class="small" role="status"></div>
            </div>

            @if (Model.GmailScopes.Count > 0)
            {
                <div class="ims-block">
                    <h2 class="ims-h">What each Gmail mailbox is archived with</h2>
                    <p class="text-muted small mb-2">Mail that matches a mailbox's Gmail search filter is never downloaded, so it is not in the archive. Changing a filter is recorded in the history log.</p>
                    <ul class="small mb-0">
                        @foreach (var g in Model.GmailScopes)
                        {
                            <li><strong>@g.Account</strong>: @(g.Filter == null ? "everything in the mailbox" : "everything except mail matching ")@if (g.Filter != null) { <code>@g.Filter</code> }</li>
                        }
                    </ul>
                </div>
            }

            <div class="ims-block">
                <h2 class="ims-h">History fingerprint</h2>
                <p class="text-muted small mb-2">
                    One line that describes the history log as it is now. Keep a copy somewhere the archive server cannot change (a note, a private
                    repository, another machine). If the history is ever rewritten, the copy will no longer match.
                </p>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control font-monospace" id="anchorLine" readonly value="@Model.AnchorLine" aria-label="History fingerprint" />
                    <button class="btn btn-outline-secondary" type="button" id="btnCopyAnchor">Copy</button>
                </div>
            </div>
        </div>
    </div>

    @* ================================================================ SIGNED RECORDS *@
    <div class="card mb-3" id="manifests">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Signed records</strong>
            <button type="button" class="btn btn-primary btn-sm" id="btnManifest"><i class="bi bi-pen" aria-hidden="true"></i> Create a signed record</button>
        </div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("manifests", out var manifestError))
            {
                <div class="alert alert-danger" role="alert">This part could not be loaded: @manifestError</div>
            }
            <p class="text-muted small">
                A signed record (a manifest) lists every stored email with its fingerprint and the history position, and is signed so that anyone can check it
                later without this software.
            </p>
            <p class="small">
                @if (!string.IsNullOrEmpty(Model.PublicKeyFingerprint))
                {
                    <span>Public key fingerprint: <code>@Model.PublicKeyFingerprint</code>. <a asp-action="DownloadManifestFile" asp-route-kind="key">Download the public key (public-key.pem)</a></span>
                }
                else
                {
                    <span class="text-muted">There is no signing key yet. It is created with the first signed record.</span>
                }
            </p>
            <div id="manifestMsg" class="small mb-2" role="status"></div>
            @if (Model.Manifests.Count == 0)
            {
                <p class="text-muted">No signed records yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Name</th><th>Created</th><th class="text-end">Emails</th><th class="text-end">History entry</th><th>Files</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.Manifests)
                        {
                            <tr>
                                <td><code>@m.Name</code></td>
                                <td>@Utc(m.GeneratedAt)</td>
                                <td class="text-end">@m.Entries</td>
                                <td class="text-end">@(m.ChainSeq?.ToString() ?? "-")</td>
                                <td class="text-nowrap">
                                    <a asp-action="DownloadManifestFile" asp-route-name="@m.Name" asp-route-kind="json" title="manifest .json">header</a> ·
                                    <a asp-action="DownloadManifestFile" asp-route-name="@m.Name" asp-route-kind="sig" title="signature .sig">signature</a> ·
                                    <a asp-action="DownloadManifestFile" asp-route-name="@m.Name" asp-route-kind="jsonl" title="entry list .jsonl">list</a>
                                </td>
                                <td class="text-end"><button type="button" class="btn btn-outline-secondary btn-sm btn-verify-manifest" data-name="@m.Name">Check</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                var first = Model.Manifests[0].Name;
                <p class="small text-muted mb-1">To check the newest one yourself, on any computer that has the three files and the public key, run:</p>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control font-monospace" id="opensslCmd" readonly aria-label="Command to check the newest signed record"
                           value="openssl dgst -sha256 -verify public-key.pem -signature @(first).sig @(first).json" />
                    <button class="btn btn-outline-secondary" type="button" id="btnCopyOpenssl">Copy</button>
                </div>
            }
        </div>
    </div>

    @* ================================================================ TRASH (the "original bin" internally) *@
    <div class="card mb-3" id="bin">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Trash for deleted originals</strong>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBinRun">Empty Trash now</button>
        </div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("bin", out var binError))
            {
                <div class="alert alert-danger" role="alert">This part could not be loaded: @binError</div>
            }
            <p class="text-muted small">
                When an email is deleted on purpose and no other email shares its original, the original file goes into the Trash first. It can be restored
                until the time is up. After that the <strong>file</strong> is erased for good, and only a backup can bring it back. Not covered by this:
                subjects and senders in the access log, and your backups. The text taken out of attachments is removed once no email has that attachment any more.
                An original is only moved when the history log holds a delete request for it, so files without one are left alone and just listed.
            </p>
            @if (Model.BinStatus != null)
            {
                var b = Model.BinStatus;
                <p class="mb-1">
                    @if (!b.Enabled)
                    {
                        <span>The Trash is <strong>off</strong>. Originals of deleted emails stay where they are.</span>
                    }
                    else if (!b.Applicable)
                    {
                        <span>The Trash is on, but it does not apply to this archive: @b.NotApplicableReason</span>
                    }
                    else
                    {
                        <span>The Trash is <strong>on</strong>. Deleted emails' originals are kept for <strong>@b.BinRetentionDays days</strong> and then erased for good.
                        It runs every @b.IntervalHours @Plural(b.IntervalHours, "hour", "hours") and handles at most @b.MaxFilesPerRun files at a time.</span>
                    }
                </p>
                <p class="mb-1">
                    In the Trash now: <strong>@b.InBin</strong> @Plural(b.InBin, "original", "originals") (@Size(b.InBinBytes))@(b.EarliestPurgeAt.HasValue ? ". The first is erased for good after " + Utc(b.EarliestPurgeAt) : "").
                </p>
                <p class="small text-muted">
                    So far: @b.TotalBinned moved to the Trash, @b.TotalRestored restored, @b.TotalPurged erased for good.
                    @if (b.LastRun != null) { <span>Last run: @b.LastRun.Status, @Utc(b.LastRun.StartedAt).</span> }
                </p>
            }
            @if (Model.BinStatus?.Identity != null && !Model.BinStatus.Identity.Ok)
            {
                <div class="ims-result bad mb-2">
                    <div><strong>✕ The Trash is paused.</strong> @Model.BinStatus.Identity.Message</div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="btnBinAdopt">This is the right archive</button>
                </div>
            }
            @if (Model.BinStatus?.LastRun?.Alarm != null && (Model.BinStatus.Identity == null || Model.BinStatus.Identity.Ok))
            {
                <div class="ims-result bad mb-2">
                    <div><strong>✕ The last run did nothing.</strong> @Model.BinStatus.LastRun.Alarm</div>
                    @if (Model.BinStatus.LastRun.Alarm.Contains("safety limit"))
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="btnBinAnyway">Run anyway</button>
                    }
                </div>
            }
            @if (Model.BinStatus?.LastRun != null && Model.BinStatus.LastRun.Unclaimed > 0)
            {
                <p class="small mb-2">
                    <strong>@Model.BinStatus.LastRun.Unclaimed</strong> @Plural(Model.BinStatus.LastRun.Unclaimed, "original has", "originals have") no email and no recorded delete request. They are left alone.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" id="btnBinUnclaimed">Show them</button>
                </p>
                <div id="unclaimedBox" class="d-none"></div>
            }
            <div id="binMsg" class="small mb-2" role="status"></div>
            @if (Model.BinItems.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Original (fingerprint)</th><th>Put in the Trash</th><th>Erased for good after</th><th class="text-end">Size</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.BinItems)
                        {
                            <tr>
                                <td><code title="@i.Sha256">@(i.Sha256[..16])…</code></td>
                                <td>@Utc(i.BinnedAt)</td>
                                <td>@Utc(i.PurgeAfter)</td>
                                <td class="text-end">@Size(i.Size)</td>
                                <td class="text-end"><button type="button" class="btn btn-outline-secondary btn-sm btn-bin-restore" data-sha="@i.Sha256">Restore from Trash</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.BinStatus != null && Model.BinStatus.InBin > Model.BinItems.Count)
                {
                    <p class="small text-muted">Showing the first @Model.BinItems.Count of @Model.BinStatus.InBin.</p>
                }
            }
            else
            {
                <p class="text-muted">The Trash is empty.</p>
            }
        </div>
    </div>

    @* ================================================================ MESSAGES THAT COULD NOT BE ARCHIVED *@
    <div class="card mb-3" id="problems">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Messages that could not be archived</strong>
            @if (Model.QuarantinedCount > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm btn-problem-retry" data-id="">Try all again</button>
            }
        </div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("problems", out var probError))
            {
                <div class="alert alert-danger" role="alert">This part could not be loaded: @probError</div>
            }
            <p class="text-muted small">
                A message that fails to archive several times in a row is set aside, so one bad message cannot hold back a whole mailbox. It stays on
                the mail server, it is not fetched again on its own, and the account is <strong>not</strong> counted as completely archived while any
                message is set aside. Try it again once the cause is fixed.
            </p>
            @if (Model.SyncProblems.Count == 0)
            {
                <p class="mb-0">✓ No messages are waiting.</p>
            }
            else
            {
                <p class="mb-2">@Model.QuarantinedCount @Plural(Model.QuarantinedCount, "message is", "messages are") set aside. @(Model.SyncProblems.Count - Model.QuarantinedCount > 0 ? (Model.SyncProblems.Count - Model.QuarantinedCount) + " more failed recently and will be tried again at the next sync." : "")</p>
                <div id="problemMsg" class="small mb-2" role="status"></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Mailbox</th><th>Folder</th><th>Message</th><th>Why</th><th class="text-end">Failures</th><th>State</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.SyncProblems)
                        {
                            <tr>
                                <td>@(Model.AccountNames.TryGetValue(p.MailAccountId, out var an) ? an : "#" + p.MailAccountId)</td>
                                <td>@p.FolderName</td>
                                <td><span class="small text-muted">UID @p.Uid</span>@(string.IsNullOrEmpty(p.MessageId) ? "" : " ")@if (!string.IsNullOrEmpty(p.MessageId)) { <code class="small">@(p.MessageId.Length > 40 ? p.MessageId[..40] + "…" : p.MessageId)</code> }</td>
                                <td class="small">@(p.Reason.Length > 140 ? p.Reason[..140] + "…" : p.Reason)</td>
                                <td class="text-end">@p.FailCount</td>
                                <td>@(p.Status == "Quarantined" ? "Set aside" : "Will retry")</td>
                                <td class="text-end">@if (p.Status == "Quarantined") { <button type="button" class="btn btn-outline-secondary btn-sm btn-problem-retry" data-id="@p.Id">Try again</button> }</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ================================================================ ATTACHMENT TEXT *@
    <div class="card mb-3" id="text">
        <div class="card-header"><strong>Searching inside attachments and pictures</strong></div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("text", out var textError))
            {
                <div class="alert alert-danger" role="alert">This part could not be loaded: @textError</div>
            }
            <p class="text-muted small">
                Text is taken out of attachments (PDF, Word, Excel and so on) so that it can be found by searching. Pictures and scanned pages are read
                with OCR, which turns the picture of text into text.
            </p>
            @if (Model.TextStatus != null)
            {
                var t = Model.TextStatus;
                var off = string.Equals(t.Mode, "off", StringComparison.OrdinalIgnoreCase);
                <p class="mb-1">
                    Reading attachments is <strong>@(off ? "off" : "on")</strong>@(off ? "." : " (" + Plain("Ocr:Mode", t.Mode.ToLowerInvariant()).ToLowerInvariant() + ").")
                    Waiting to be read: <strong>@t.PendingAttachments</strong>. Emails waiting for their search text: <strong>@t.EmailsAwaitingIndex</strong>.
                </p>
                <p class="small mb-2">
                    @if (t.OcrUnavailable != null)
                    {
                        <span>Reader for pictures: <strong>not available</strong>. @t.OcrUnavailable</span>
                    }
                    else if (t.OcrEngine == null)
                    {
                        <span class="text-muted">Reader for pictures: not in use (reading is off).</span>
                    }
                    else if (t.OcrEngine.Contains("not loaded"))
                    {
                        <span>Reader for pictures: PaddleOCR v5, <strong>not started yet</strong>. It starts when the first picture needs reading.</span>
                    }
                    else
                    {
                        <span>Reader for pictures: PaddleOCR v5 (<strong>ready</strong>).</span>
                    }
                    @if (t.OcrEngine != null)
                    {
                        <details class="d-inline ms-1"><summary class="d-inline text-muted">Technical details</summary> <code>@t.OcrEngine</code></details>
                    }
                </p>
                @if (t.Texts.Count > 0)
                {
                    <table class="table table-sm w-auto">
                        <thead><tr><th>What happened</th><th>How it was read</th><th class="text-end">Attachments</th></tr></thead>
                        <tbody>
                        @foreach (var x in t.Texts)
                        {
                            <tr>
                                <td>@(x.Status switch { "Done" => "Read", "NeedsOcr" => "Waiting for OCR", "Unsupported" => "Type not supported", "Failed" => "Could not be read", _ => x.Status })</td>
                                <td>@(x.Method switch { "textlayer" => "text in the file", "ocr" => "OCR (reading the picture)", _ => x.Method })</td>
                                <td class="text-end">@x.Count</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if (t.Failures != null && t.Failures.Count > 0)
                    {
                        <p class="small mb-1">Why some could not be read:</p>
                        <ul class="small">
                            @foreach (var f in t.Failures)
                            {
                                <li>@f.Count @Plural(f.Count, "attachment", "attachments"): @Reason(f.Reason)</li>
                            }
                        </ul>
                    }
                }
                else { <p class="text-muted">Nothing has been read yet.</p> }
            }
            <div id="textMsg" class="small mb-2" role="status"></div>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-rescan" data-scope="failed">Try the unreadable ones again</button>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-rescan" data-scope="needsocr">Read the ones waiting for OCR</button>
            <div class="small text-muted mt-2">This only clears those results. The reader works through them again in the background.</div>
        </div>
    </div>

    @* ================================================================ SETTINGS *@
    <div class="card mb-3" id="settings">
        <div class="card-header"><strong>Settings</strong></div>
        <div class="card-body">
            @if (Model.Errors.TryGetValue("settings", out var settingsError))
            {
                <div class="alert alert-danger" role="alert">This part could not be loaded: @settingsError</div>
            }
            @if (Model.SaveMessage != null)
            {
                <div class="alert alert-danger" role="alert">@Model.SaveMessage</div>
            }
            @if (settingsMessage != null)
            {
                <div class="alert @(settingsOk == true ? "alert-success" : "alert-danger")" role="alert">
                    @settingsMessage
                    @if (appliedLines.Length > 0)
                    {
                        <ul class="mb-0 mt-1 small">@foreach (var l in appliedLines) { <li>@l</li> }</ul>
                    }
                </div>
            }
            @if (notAppliedLines.Length > 0)
            {
                <div class="alert alert-secondary" role="status">
                    <strong>Not changed here:</strong>
                    <ul class="mb-0 mt-1 small">@foreach (var l in notAppliedLines) { <li>@l</li> }</ul>
                </div>
            }
            <p class="text-muted small ims-intro">
                Change as many settings as you like, then press <strong>Save</strong> once. Either all of your changes are saved or none of them.
                Saved changes are used within about half a minute, unless a line says it needs a restart. Every change is recorded with the old and the new value.
            </p>

            @* ---------------------------------------------------------------- change here: ONE form, ONE Save *@
            <form id="settingsForm" method="post" asp-action="SaveSettings" data-local="@(Model.HasLocalPassword ? "true" : "false")"
                  data-reopen="@(Model.PasswordProblem != null ? "true" : "false")" data-reopen-message="@Model.PasswordProblem">
                <input type="hidden" name="password" id="savePassword" value="" disabled />
                <div class="ims-block">
                    <div class="ims-headrow">
                        <h2 class="ims-h mb-0">You can change these here</h2>
                        <div class="ims-dirty ims-quiet" id="dirtyBar" role="status">
                            <span class="small"><i class="bi bi-pencil" aria-hidden="true"></i> <strong id="dirtyCount">0 unsaved changes</strong></span>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDiscardTop">Discard changes</button>
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </div>
                    </div>
                    <p class="text-muted small">Some changes make the archive less protected. When you save one of those, you are asked for your password first.</p>
                    <div class="ims-group">
                    @foreach (var s in editable)
                    {
                        var rowId = Id(s.Key);
                        var isReset = Model.PostedResets.Contains(s.Key);
                        var shown = isReset ? s.Default : (Model.PostedValues.TryGetValue(s.Key, out var posted) ? posted : s.Value);
                        var hasError = Model.SettingErrors.TryGetValue(s.Key, out var rowError);
                        <div class="ims-row ims-set-row" data-key="@s.Key" data-label="@s.Label" data-old="@s.Value" data-default="@s.Default" data-rule="@s.PasswordRule"
                             data-source="@s.Source">
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="fw-semibold" for="v-@rowId">@s.Label</label>
                                    <div class="small text-muted">@s.Help</div>
                                    @if (s.RiskyNote != null)
                                    {
                                        <div class="small text-muted ims-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>@s.RiskyNote @PasswordHint(s.PasswordRule)</span></div>
                                    }
                                    @if (!s.AppliesLive && s.RestartNote != null)
                                    {
                                        <div class="small text-muted ims-note"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>@s.RestartNote</span></div>
                                    }
                                    <details class="small text-muted"><summary>Technical name</summary>Can be set on the server with <code>@s.EnvVar</code>@Compat(s.EnvVar).</details>
                                </div>
                                <div class="col-lg-6">
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        @if (s.Kind == SettingKind.Bool)
                                        {
                                            <select id="v-@rowId" name="v_@s.Key" class="form-select form-select-sm w-auto" aria-describedby="e-@rowId">
                                                <option value="true" selected="@(shown == "true")">On</option>
                                                <option value="false" selected="@(shown == "false")">Off</option>
                                            </select>
                                        }
                                        else if (s.Kind == SettingKind.Choice)
                                        {
                                            <select id="v-@rowId" name="v_@s.Key" class="form-select form-select-sm w-auto" aria-describedby="e-@rowId">
                                                @foreach (var c in s.Choices) { <option value="@c" selected="@(c == shown)">@Plain(s.Key, c)</option> }
                                            </select>
                                        }
                                        else
                                        {
                                            <input id="v-@rowId" type="number" name="v_@s.Key" value="@shown" min="@s.Min" max="@s.Max" class="form-control form-control-sm" style="width:9rem" aria-describedby="e-@rowId" />
                                        }
                                        @if (s.Source == "changed in this page")
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm ims-reset-btn">Go back to the standard value</button>
                                        }
                                        <input type="hidden" class="ims-reset-flag" name="r_@s.Key" value="1" @(isReset ? "" : "disabled") />
                                    </div>
                                    <div class="small text-muted mt-1 ims-reset-note @(isReset ? "" : "d-none")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Will go back to the standard value when you save.</div>
                                    <div id="e-@rowId" class="small ims-error @(hasError ? "" : "d-none")">@if (hasError) { <span>&#10005; @rowError</span> }</div>
                                    <div class="small text-muted mt-1">
                                        @if (s.Kind == SettingKind.Int) { <span>Allowed: @s.Min to @s.Max. </span> }
                                        Standard value: @Plain(s.Key, s.Default).
                                        @if (s.Source == "changed in this page")
                                        {
                                            <span class="ims-badge">changed by @s.ChangedBy, @Utc(s.ChangedAt)</span>
                                        }
                                        else
                                        {
                                            <span class="ims-badge">standard value</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
                        <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        <button type="button" class="btn btn-link btn-sm" id="btnDiscardBottom">Revert changes</button>
                        <span id="nothingToSave" class="small text-muted" role="status"></span>
                    </div>
                </div>
            </form>

            @* ---------------------------------------------------------------- set by the server *@
            <div class="ims-block ims-panel">
                <h2 class="ims-h">Set by the server</h2>
                <p class="text-muted small">These could be changed here, but the server's own settings take priority.</p>
                @if (pinned.Count == 0)
                {
                    <p class="text-muted small mb-0">Nothing is set by the server at the moment.</p>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="table table-sm align-middle ims-table mb-2">
                        <thead><tr><th scope="col">Setting</th><th scope="col">Value</th><th scope="col">Technical name</th></tr></thead>
                        <tbody>
                        @foreach (var s in pinned)
                        {
                            <tr>
                                <td><div class="fw-semibold">@s.Label</div><div class="small text-muted">@s.Help</div></td>
                                <td><strong>@Plain(s.Key, s.Value)</strong></td>
                                <td><code>@s.EnvVar</code><span class="small text-muted">@Compat(s.EnvVar)</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div>
                    <p class="small text-muted mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> To change one here, remove it from the compose file or environment and restart the application.</p>
                }
            </div>

            @* ---------------------------------------------------------------- locked *@
            <div class="ims-block">
                <h2 class="ims-h">Locked for safety</h2>
                <p class="text-muted small">These decide how the archive keeps its originals and its history. They cannot be changed here.</p>
                <div class="table-responsive">
                <table class="table table-sm align-middle ims-table mb-0">
                    <thead><tr><th scope="col">Setting</th><th scope="col">Value</th><th scope="col">Technical name</th></tr></thead>
                    <tbody>
                    @foreach (var s in locked)
                    {
                        <tr>
                            <td><div class="fw-semibold">@s.Label</div><div class="small text-muted">@s.Help</div></td>
                            <td><code>@Plain(s.Key, s.Value)</code></td>
                            <td><code>@s.EnvVar</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------------------------------------------------------------- the confirmation dialog (presentation only: the server enforces the password) *@
<div class="modal fade ims" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="confirmTitle">Confirm these changes</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmIntro" class="small"></p>
                <ul id="confirmList" class="small"></ul>
                <div id="confirmCannot" class="d-none">
                    <p class="small mb-1"><strong>These cannot be changed here:</strong></p>
                    <ul id="confirmCannotList" class="small"></ul>
                    <p class="small text-muted">Your account signs in with single sign-on, so it has no password to confirm with. Set these on the server instead, with the environment variable named in the Technical name of each setting.</p>
                </div>
                <div id="confirmPwBox">
                    <label for="confirmPw" class="small">Your password</label>
                    <input id="confirmPw" type="password" class="form-control form-control-sm" autocomplete="current-password" />
                </div>
                <div id="confirmError" class="small ims-error d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="confirmGo">Confirm and save</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var token = document.querySelector('#af input[name=__RequestVerificationToken]').value;
    var base = '@Url.Action("Index")'.replace(/\/Index$/, '').replace(/\/$/, '');
    function url(action) { return base + '/' + action; }
    function post(action, body) {
        var form = new URLSearchParams(body || {});
        return fetch(url(action), { method: 'POST', credentials: 'same-origin',
            headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' }, body: form })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });
    }
    // A result is words first (the mark and the sentence); the coloured edge only adds to it.
    function show(el, text, ok, neutral) {
        el.textContent = neutral ? text : (ok ? '✓ ' : '✕ ') + text;
        el.className = el.className.replace(/\bims-result\b|\bok\b|\bbad\b/g, '').trim();
        if (!neutral) el.className = (el.className + ' ims-result ' + (ok ? 'ok' : 'bad')).trim();
    }
    function working(el, text) { show(el, text, true, true); }
    function fail(el) { return function (e) { show(el, 'Did not work: ' + (e.message || e), false); }; }
    function copy(id) { var i = document.getElementById(id); i.select(); try { navigator.clipboard.writeText(i.value); } catch (e) { document.execCommand('copy'); } }
    function plural(n, one, many) { return n === 1 ? one : many; }

    // ---- check all emails (with progress)
    var runMsg = document.getElementById('runMsg'), runText = document.getElementById('runText');
    function describe(r) {
        var problems = r.invalid + r.missing + r.notStored + r.inconsistent + r.errors;
        if (r.status === 'Running') return 'A check is running: ' + r.checked + ' of ' + r.total + ' emails checked so far.';
        if (r.status === 'Completed' && problems === 0) return 'All ' + r.checked + ' ' + plural(r.checked, 'email matches', 'emails match') + ' its original.';
        if (r.status === 'Completed') return 'Checked ' + r.checked + ' emails: ' + problems + ' ' + plural(problems, 'needs', 'need') + ' attention (' + r.invalid + ' changed, ' + r.missing +
            ' with the original missing, ' + r.notStored + ' with no original kept, ' + r.inconsistent + ' that differ from the original, ' + r.errors + ' that could not be checked).';
        return 'The check did not finish (' + r.status + '). It had checked ' + r.checked + ' of ' + r.total + ' emails.';
    }
    function poll() {
        fetch(url('RunStatus'), { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (r) {
            if (!r) return;
            if (!runText) { runText = document.createElement('span'); document.getElementById('runBox').textContent = ''; document.getElementById('runBox').appendChild(runText); }
            runText.textContent = describe(r);
            if (r.status === 'Running') setTimeout(poll, 2000);
            else show(runMsg, r.status === 'Completed' ? 'The check finished.' : 'The check did not finish.', r.status === 'Completed' && !r.invalid && !r.missing && !r.inconsistent && !r.notStored && !r.errors);
        }).catch(fail(runMsg));
    }
    document.getElementById('btnVerifyAll').addEventListener('click', function () {
        working(runMsg, 'Starting...');
        post('RunVerifyAll').then(function (r) { if (!r.ok) return show(runMsg, r.message, false); working(runMsg, 'Running...'); poll(); }).catch(fail(runMsg));
    });

    // ---- history log
    document.getElementById('btnChain').addEventListener('click', function () {
        var box = document.getElementById('chainResult'); working(box, 'Checking...');
        post('CheckChain').then(function (r) {
            if (!r.ok) return show(box, r.message, false);
            var lines = [r.chainOk ? 'The history log is intact (' + r.entries + ' ' + plural(r.entries, 'entry', 'entries') + ').'
                : 'A problem was found in the history log.'];
            if (r.firstBreak) lines.push('It first goes wrong at entry ' + r.firstBreak.seq + ': ' + r.firstBreak.reason);
            (r.warnings || []).forEach(function (w) { lines.push('Note: ' + w); });
            lines.push('Emails stored before the history log existed: ' + r.unchained + (r.unchained ? ' (normal for older mail)' : '') + '. Emails deleted with a record: ' +
                r.emailsDeletedWithRecord + '. Originals moved to the Trash: ' + r.originalsBinned + ', restored: ' + r.originalsRestored + ', erased for good: ' + r.originalsPurged + '.');
            show(box, lines.join('\n'), r.chainOk);
        }).catch(fail(box));
    });
    document.getElementById('btnCopyAnchor').addEventListener('click', function () {
        fetch(url('Anchor'), { credentials: 'same-origin' }).then(function (r) { return r.text(); }).then(function (t) {
            var i = document.getElementById('anchorLine'); i.value = t.trim(); copy('anchorLine');
        });
    });

    // ---- signed records
    var mm = document.getElementById('manifestMsg');
    document.getElementById('btnManifest').addEventListener('click', function () {
        working(mm, 'Creating...');
        post('CreateManifest').then(function (r) {
            if (!r.ok) return show(mm, r.message, false);
            show(mm, 'Created ' + r.name + ' (' + r.entries + ' ' + plural(r.entries, 'email', 'emails') + '). Reloading...', true); setTimeout(function () { location.hash = '#manifests'; location.reload(); }, 800);
        }).catch(fail(mm));
    });
    document.querySelectorAll('.btn-verify-manifest').forEach(function (b) {
        b.addEventListener('click', function () {
            working(mm, 'Checking ' + b.dataset.name + '...');
            post('VerifyManifest', { name: b.dataset.name }).then(function (r) {
                if (!r.ok) return show(mm, r.message, false);
                var t = r.name + ': ' + (r.manifestOk ? 'all good. ' : 'a problem was found. ') +
                    'The signature is ' + (r.signatureValid ? 'valid' : 'NOT valid') + ', the list of emails ' + (r.entriesFileMatches ? 'matches it' : 'does NOT match it') +
                    ', and the history position ' + (r.chainStillContainsHead ? 'is still in the history log' : 'is MISSING or changed') + '. ' +
                    r.emailsChangedOrMissingSince + ' ' + plural(r.emailsChangedOrMissingSince, 'email is', 'emails are') + ' gone or changed since it was written.' +
                    (r.problems && r.problems.length ? ' ' + r.problems.join(' ') : '');
                show(mm, t, r.manifestOk);
            }).catch(fail(mm));
        });
    });
    var oc = document.getElementById('btnCopyOpenssl'); if (oc) oc.addEventListener('click', function () { copy('opensslCmd'); });

    // ---- bin
    var bm = document.getElementById('binMsg');
    document.getElementById('btnBinRun').addEventListener('click', function () {
        if (!confirm('Empty the Trash now? Originals that no email refers to are moved into the Trash, and originals that have been in the Trash long enough are deleted for good.')) return;
        working(bm, 'Starting...');
        post('BinRun').then(function (r) { r.ok ? show(bm, 'The Trash run has started. Reload the page in a moment to see the result.', true) : show(bm, r.message, false); }).catch(fail(bm));
    });
    var adopt = document.getElementById('btnBinAdopt');
    if (adopt) adopt.addEventListener('click', function () {
        if (!confirm('Only do this if you are sure this database and this originals folder belong together (for example after an upgrade, or after you moved or restored the folder on purpose). Continue?')) return;
        working(bm, 'Working...');
        post('BinAdopt').then(function (r) { show(bm, r.message, r.ok); if (r.ok) setTimeout(function () { location.hash = '#bin'; location.reload(); }, 800); }).catch(fail(bm));
    });
    var anyway = document.getElementById('btnBinAnyway');
    if (anyway) anyway.addEventListener('click', function () {
        if (!confirm('Run the Trash again without the safety limit? Every original with a recorded delete request will be moved to the Trash (you can restore them until the time is up).')) return;
        working(bm, 'Starting...');
        post('BinRun', { anyway: 'true' }).then(function (r) { r.ok ? show(bm, 'The Trash run has started. Reload the page in a moment to see the result.', true) : show(bm, r.message, false); }).catch(fail(bm));
    });
    var unc = document.getElementById('btnBinUnclaimed');
    if (unc) unc.addEventListener('click', function () {
        var box = document.getElementById('unclaimedBox');
        working(bm, 'Looking through the originals folder...');
        post('BinUnclaimed').then(function (r) {
            if (!r.ok) { show(bm, r.message, false); return; }
            bm.textContent = '';
            box.textContent = ''; box.classList.remove('d-none');
            if (!r.items.length) { box.textContent = 'None found.'; return; }
            var table = document.createElement('table'); table.className = 'table table-sm align-middle';
            r.items.forEach(function (i) {
                var tr = document.createElement('tr');
                var c1 = document.createElement('td'); var code = document.createElement('code'); code.title = i.sha256; code.textContent = i.sha256.substring(0, 16) + '…'; c1.appendChild(code);
                var c2 = document.createElement('td'); c2.textContent = i.modified;
                var c3 = document.createElement('td'); c3.className = 'text-end'; c3.textContent = Math.max(1, Math.round(i.size / 1024)) + ' KB';
                var c4 = document.createElement('td'); c4.className = 'text-end';
                var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'btn btn-outline-secondary btn-sm'; btn.textContent = 'Move to Trash';
                btn.addEventListener('click', function () {
                    if (!confirm('Move this original to the Trash? No delete request was recorded for it. You can restore it until the time is up.')) return;
                    post('BinMoveUnclaimed', { sha256: i.sha256 }).then(function (m) { show(bm, m.message, m.ok); if (m.ok) tr.remove(); }).catch(fail(bm));
                });
                c4.appendChild(btn);
                tr.appendChild(c1); tr.appendChild(c2); tr.appendChild(c3); tr.appendChild(c4); table.appendChild(tr);
            });
            box.appendChild(table);
        }).catch(fail(bm));
    });
    document.querySelectorAll('.btn-bin-restore').forEach(function (b) {
        b.addEventListener('click', function () {
            post('BinRestore', { sha256: b.dataset.sha }).then(function (r) {
                show(bm, r.message, r.ok); if (r.ok) setTimeout(function () { location.hash = '#bin'; location.reload(); }, 800);
            }).catch(fail(bm));
        });
    });

    // ---- messages that could not be archived
    document.querySelectorAll('.btn-problem-retry').forEach(function (b) {
        b.addEventListener('click', function () {
            var pm = document.getElementById('problemMsg') || bm;
            post('ProblemRetry', b.dataset.id ? { id: b.dataset.id } : {}).then(function (r) {
                show(pm, r.message, r.ok); if (r.ok && r.count > 0) setTimeout(function () { location.hash = '#problems'; location.reload(); }, 900);
            }).catch(fail(pm));
        });
    });

    // ---- attachment text
    var tm = document.getElementById('textMsg');
    document.querySelectorAll('.btn-rescan').forEach(function (b) {
        b.addEventListener('click', function () {
            var which = b.dataset.scope === 'needsocr' ? 'the ones waiting for OCR' : 'the unreadable ones';
            if (!confirm('Clear the results for ' + which + ' so they are read again?')) return;
            post('OcrRescan', { scope: b.dataset.scope }).then(function (r) {
                r.ok ? show(tm, 'Cleared ' + r.removed + ' ' + plural(r.removed, 'result', 'results') + '. The reader will go through them again.', true) : show(tm, r.message, false);
            }).catch(fail(tm));
        });
    });

    // ---- settings: ONE form, ONE Save. The dialog is only presentation; the server decides and enforces the password.
    function asksPassword(rule, oldV, newV) {
        if (!rule) return false;
        if (rule === 'off') return oldV === 'true' && newV === 'false';
        if (rule === 'lower') return Number(newV) < Number(oldV);
        if (rule === 'zero') return Number(newV) === 0 && Number(oldV) !== 0;
        if (rule === 'change') return newV !== oldV;
        return false;
    }
    var form = document.getElementById('settingsForm');
    if (form) {
        var rows = Array.prototype.slice.call(form.querySelectorAll('.ims-set-row'));
        var bar = document.getElementById('dirtyBar'), barCount = document.getElementById('dirtyCount');
        var hasLocal = form.dataset.local === 'true';
        var nothing = document.getElementById('nothingToSave');

        function inputOf(row) { return row.querySelector('[name^="v_"]'); }
        function flagOf(row) { return row.querySelector('.ims-reset-flag'); }
        function noteOf(row) { return row.querySelector('.ims-reset-note'); }
        function state(row) {
            var input = inputOf(row), flag = flagOf(row), reset = !flag.disabled;
            var newV = reset ? row.dataset.default : input.value;
            return { row: row, reset: reset, oldV: row.dataset.old, newV: newV, rule: row.dataset.rule, label: row.dataset.label,
                     changed: reset ? row.dataset.default !== row.dataset.old || row.dataset.source !== 'default' : input.value !== row.dataset.old };
        }
        function text(row, v) {
            var sel = row.querySelector('select');
            if (sel) { for (var i = 0; i < sel.options.length; i++) if (sel.options[i].value === v) return sel.options[i].text; }
            return v;
        }
        function changed() { return rows.map(state).filter(function (x) { return x.changed; }); }
        function refresh() {
            var n = changed().length;
            barCount.textContent = n + ' unsaved ' + plural(n, 'change', 'changes');
            bar.classList.toggle('ims-quiet', n === 0);
            rows.forEach(function (r) { r.classList.toggle('ims-edited', state(r).changed); });
            if (n > 0) nothing.textContent = '';
        }
        rows.forEach(function (row) {
            var input = inputOf(row);
            function typed() { flagOf(row).disabled = true; noteOf(row).classList.add('d-none'); refresh(); }
            input.addEventListener('input', typed); input.addEventListener('change', typed);
            var rb = row.querySelector('.ims-reset-btn');
            if (rb) rb.addEventListener('click', function () {
                input.value = row.dataset.default; flagOf(row).disabled = false; noteOf(row).classList.remove('d-none'); refresh();
            });
        });
        function discard() {
            rows.forEach(function (row) {
                inputOf(row).value = row.dataset.old; flagOf(row).disabled = true; noteOf(row).classList.add('d-none');
                var err = row.querySelector('.ims-error'); if (err) { err.classList.add('d-none'); err.textContent = ''; }
            });
            refresh();
        }
        document.getElementById('btnDiscardTop').addEventListener('click', discard);
        document.getElementById('btnDiscardBottom').addEventListener('click', discard);

        // Send only the rows that are going to be saved.
        function prepare(send) {
            rows.forEach(function (row) {
                var s = state(row), go = send.some(function (x) { return x.row === row; });
                inputOf(row).disabled = !go || s.reset;
                flagOf(row).disabled = !(go && s.reset);
            });
        }
        function line(c) {
            var li = document.createElement('li');
            var b = document.createElement('strong'); b.textContent = c.label; li.appendChild(b);
            li.appendChild(document.createTextNode(': ' + text(c.row, c.oldV) + ' \u2192 ' + (c.reset ? 'the standard value (' + text(c.row, c.newV) + ')' : text(c.row, c.newV))));
            return li;
        }
        var pending = { safe: [], risky: [] };
        function openDialog(safe, risky, problem) {
            pending = { safe: safe, risky: risky };
            var list = document.getElementById('confirmList'), cannot = document.getElementById('confirmCannot'), cannotList = document.getElementById('confirmCannotList');
            var pwBox = document.getElementById('confirmPwBox'), err = document.getElementById('confirmError'), go = document.getElementById('confirmGo');
            list.textContent = ''; cannotList.textContent = ''; err.classList.add('d-none'); err.textContent = '';
            document.getElementById('confirmPw').value = '';
            if (hasLocal) {
                document.getElementById('confirmIntro').textContent = 'You are about to save ' + (safe.length + risky.length) + ' ' + plural(safe.length + risky.length, 'change', 'changes') +
                    '. Some of them make the archive less protected, so please enter your password to confirm.';
                safe.concat(risky).forEach(function (c) { list.appendChild(line(c)); });
                cannot.classList.add('d-none'); pwBox.classList.remove('d-none'); go.classList.remove('d-none'); go.textContent = 'Confirm and save';
            } else {
                document.getElementById('confirmIntro').textContent = safe.length
                    ? 'These changes can be saved here:' : 'None of these changes can be made here.';
                safe.forEach(function (c) { list.appendChild(line(c)); });
                risky.forEach(function (c) { cannotList.appendChild(line(c)); });
                cannot.classList.remove('d-none'); pwBox.classList.add('d-none');
                go.classList.toggle('d-none', safe.length === 0); go.textContent = 'Save the safe changes';
            }
            if (problem) { err.textContent = '\u2715 ' + problem; err.classList.remove('d-none'); }
            window.bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmModal')).show();
            setTimeout(function () { var pw = document.getElementById('confirmPw'); if (hasLocal) pw.focus(); }, 300);
        }
        form.addEventListener('submit', function (e) {
            var all = changed();
            if (all.length === 0) { e.preventDefault(); nothing.textContent = 'There is nothing to save.'; return; }
            var risky = all.filter(function (c) { return asksPassword(c.rule, c.oldV, c.newV); });
            if (risky.length === 0) { prepare(all); return; }          // nothing risky: saves straight away, no dialog
            e.preventDefault();
            openDialog(all.filter(function (c) { return risky.indexOf(c) < 0; }), risky);
        });
        document.getElementById('confirmGo').addEventListener('click', function () {
            var err = document.getElementById('confirmError');
            if (hasLocal) {
                var pw = document.getElementById('confirmPw').value;
                if (!pw) { err.textContent = '\u2715 Enter your password.'; err.classList.remove('d-none'); return; }
                var hidden = document.getElementById('savePassword'); hidden.value = pw; hidden.disabled = false;
                prepare(pending.safe.concat(pending.risky));
            } else {
                prepare(pending.safe);
            }
            form.submit();
        });
        if (form.dataset.reopen === 'true') {
            window.addEventListener('load', function () {
                var all = changed(), risky = all.filter(function (c) { return asksPassword(c.rule, c.oldV, c.newV); });
                openDialog(all.filter(function (c) { return risky.indexOf(c) < 0; }), risky, form.dataset.reopenMessage);
            });
        }
        refresh();
    }
})();
</script>
